FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-mcp-bridge.txt /app/requirements-mcp-bridge.txt
RUN pip install --no-cache-dir -r /app/requirements-mcp-bridge.txt

COPY mcp_bridge /app/mcp_bridge

EXPOSE 8080

CMD ["uvicorn", "mcp_bridge.main:app", "--host", "0.0.0.0", "--port", "8080"]
